# Copy to .env and fill in. .env is gitignored and must never be committed.

# --- Paper trading (development default) ---
ALPACA_PAPER_KEY_ID=
ALPACA_PAPER_SECRET_KEY=

# --- Live trading (present ONLY on the live host) ---
# ALPACA_LIVE_KEY_ID=
# ALPACA_LIVE_SECRET_KEY=

# --- Market data ---
# iex = free, IEX-only tape. sip = paid, full consolidated tape.
ALPACA_DATA_FEED=iex

# --- Alerting ---
# Webhook the bot posts critical/warning alerts to (Slack, Discord, ntfy, ...).
ALERT_WEBHOOK_URL=

# --- Optional overrides ---
# LOG_LEVEL=INFO
# METRICS_PORT=9090
